{
  "name": "tsondb",
  "version": "0.20.3",
  "description": "",
  "license": "ISC",
  "author": "Lukas Obermann",
  "type": "module",
  "files": [
    "dist/src/**/*.{d.ts,js}",
    "public"
  ],
  "bin": {
    "tsondb": "dist/src/node/bin/tsondb.js"
  },
  "main": "dist/src/node/index.js",
  "exports": {
    ".": "./dist/src/node/index.js",
    "./config": "./dist/src/node/config.js",
    "./renderer/jsonschema": "./dist/src/node/renderers/jsonschema/index.js",
    "./renderer/ts": "./dist/src/node/renderers/ts/index.js",
    "./schema": "./dist/src/node/schema/index.js",
    "./schema/dsl": "./dist/src/node/schema/dsl/index.js",
    "./schema/gen": "./dist/src/node/schema/generatedTypeHelpers.js"
  },
  "scripts": {
    "build": "tsc -b",
    "build:web": "rslib build",
    "watch": "tsc -b -w",
    "watch:web": "rslib build -w",
    "test": "node --import tsx --test",
    "lint": "eslint",
    "format": "prettier \"{src,test}/**/*.{ts,tsx}\" --write",
    "format:check": "prettier \"{src,test}/**/*.{ts,tsx}\" --check",
    "release": "commit-and-tag-version",
    "release:sign": "commit-and-tag-version --sign --signoff"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@rsbuild/plugin-preact": "^2.0.0",
    "@rslib/core": "^0.22.0",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.2",
    "commit-and-tag-version": "^12.7.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "rslib": "^0.0.10",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  },
  "dependencies": {
    "@elyukai/markdown": "^0.2.2",
    "@elyukai/utils": "^0.3.4",
    "@preact/signals": "^2.9.1",
    "debug": "^4.4.3",
    "express": "^5.2.1",
    "messageformat": "^4.0.0",
    "preact": "^10.29.2",
    "preact-iso": "^2.12.0",
    "simple-cli-args": "^0.1.3",
    "simple-git": "^3.36.0"
  },
  "repository": "github:elyukai/tsondb",
  "bugs": {
    "url": "https://github.com/elyukai/tsondb/issues"
  },
  "engines": {
    "node": ">=23.6.0"
  }
}
