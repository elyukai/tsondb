{
  "name": "tsondb",
  "version": "0.23.3",
  "description": "",
  "license": "ISC",
  "author": "Lukas Obermann",
  "type": "module",
  "files": [
    "dist/src/**/*.{d.ts,js}",
    "public"
  ],
  "bin": {
    "tsondb": "dist/src/node/bin/tsondb.js"
  },
  "main": "dist/src/node/index.js",
  "exports": {
    ".": "./dist/src/node/index.js",
    "./readonly": "./dist/src/node/readonly.js",
    "./config": "./dist/src/node/config.js",
    "./renderer/jsonschema": "./dist/src/node/renderers/jsonschema/index.js",
    "./renderer/ts": "./dist/src/node/renderers/ts/index.js",
    "./schema": "./dist/src/node/schema/index.js",
    "./schema/dsl": "./dist/src/node/schema/dsl/index.js",
    "./schema/gen": "./dist/src/node/schema/generatedTypeHelpers.js"
  },
  "scripts": {
    "build": "tsc -b",
    "build:web": "rslib build",
    "watch": "tsc -b -w",
    "watch:web": "rslib build -w",
    "test": "node --import tsx --test",
    "lint": "oxlint",
    "format": "oxfmt \"{src,test}/**/*.{ts,tsx}\"",
    "format:check": "oxfmt \"{src,test}/**/*.{ts,tsx}\" --check",
    "release": "commit-and-tag-version",
    "release:sign": "commit-and-tag-version --sign --signoff"
  },
  "devDependencies": {
    "@elyukai/oxc-config": "^0.1.4",
    "@rsbuild/plugin-preact": "^2.1.0",
    "@rslib/core": "^1.0.4",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "commit-and-tag-version": "^13.3.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "dependencies": {
    "@elyukai/markdown": "^0.4.0",
    "@elyukai/utils": "^0.3.11",
    "@preact/signals": "^2.11.3",
    "debug": "^4.4.3",
    "express": "^5.3.0",
    "messageformat": "^4.1.0",
    "preact": "^11.0.2",
    "preact-iso": "^2.12.2",
    "semver": "^7.8.5",
    "simple-cli-args": "^0.1.3",
    "simple-git": "^4.0.2"
  },
  "repository": "github:elyukai/tsondb",
  "bugs": {
    "url": "https://github.com/elyukai/tsondb/issues"
  },
  "engines": {
    "node": ">=23.6.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
